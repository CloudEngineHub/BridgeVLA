!finetune/Colosseum/robot-colosseum/**/*.jpeg
!finetune/Colosseum/robot-colosseum/**/*.gif
!finetune/bridgevla/libs/peract/**/*.png
!finetune/bridgevla/libs/peract/**/*.gif
!finetune/bridgevla/libs/peract_colab/**/*.png
!finetune/bridgevla/libs/YARR/logo.png
!finetune/bridgevla/libs/point-renderer/*.png
!finetune/RMBench/**/*.png
!finetune/RMBench/**/*.jpg

