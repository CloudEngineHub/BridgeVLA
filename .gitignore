# ===== Large assets / data / sim binaries =====
# data/ is the user-provided data and weights root (see README); both spellings are listed so that
# the directory and a symlink of the same name are matched.
/data
/data/
finetune/CoppeliaSim_Edu_V4_1_0_Ubuntu20_04
finetune/CoppeliaSim_Edu_V4_1_0_Ubuntu20_04/
finetune/CoppeliaSim_Edu_V4_1_0_Ubuntu20_04.tar.xz

# PyRep / RLBench are not tracked: the install scripts clone pinned commits and apply the patches in
# bridgevla/libs/rlbench_patches/ (see its README.md).
finetune/bridgevla/libs/PyRep/
finetune/bridgevla/libs/RLBench/
# The RLBench-benchmark-specific 587a6a0 stack, built by install_rlbench.sh
# (upstream clone + the finetune/RLBench/rlbench_patch_bundle patches)
finetune/bridgevla/libs/RLBench_peract587/
finetune/bridgevla/libs/PyRep_stepjam231/

# RMBench data/assets live under the data/ root (RMBENCH_DATA_PATH / RMBENCH_ASSETS_PATH)
finetune/RMBench/data/
finetune/RMBench/assets/
# curobo is cloned and pip -e installed by the RMBench install script; not tracked
finetune/RMBench/envs/curobo/

# ===== Training outputs / logs =====
finetune/RLBench/train/
finetune/RLBench/wandb/
finetune/Colosseum/train/
finetune/Colosseum/wandb/
finetune/GemBench/train/
finetune/GemBench/wandb/
finetune/real/logs/
finetune/real/logs_real
finetune/real/logs_real/
wandb/
*.log
.cache/

