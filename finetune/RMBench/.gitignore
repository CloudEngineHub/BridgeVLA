# The whole task_config/ directory used to be ignored, which stopped shared eval configs such as
# demo_clean.yml / _eval_step_limit.yml from syncing to other machines via git. It now ignores only
# the directory contents and re-includes these shared configs (the same ignore-then-re-include style as data/* and assets/* in this file).
task_config/*
!task_config/_camera_config.yml
!task_config/_config_template.yml
!task_config/_embodiment_config.yml
